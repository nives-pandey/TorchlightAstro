# Copy to .env and fill in. Never commit the filled-in file.
# Boot fails fast with a readable list if anything required is missing.

NODE_ENV=development
PORT=3000

# --- Required ---

# Neon pooled connection string. Use the POOLED url (it contains "-pooler"),
# not the direct one — serverless opens and drops connections constantly and
# will exhaust a direct connection limit.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/torchlight?sslmode=require

# Access-token signing key, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Shared secret for POST /api/cron/tick, sent by GitHub Actions as a header.
# Generate the same way as JWT_SECRET.
CRON_SECRET=

# --- Optional (features degrade rather than fail) ---

# Anthropic, for generating readings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Google Sign-In: the Web client ID, used as the audience when verifying the
# ID token the Android app sends.
GOOGLE_CLIENT_ID=

# --- Token lifetimes (defaults are sensible; override only with reason) ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
