{
  "name": "@torchlight/backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:shared && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "fixtures:ephemeris": "tsx scripts/generate-ephemeris-fixtures.ts",
    "fixtures:houses": "tsx scripts/generate-house-fixtures.ts",
    "build:shared": "cd ../../packages/shared-types && npm install --no-audit --no-fund && npx tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@neondatabase/serverless": "^0.10.4",
    "@nestjs/common": "11.0.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.6",
    "@nestjs/throttler": "^6.5.0",
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^6.0.0",
    "dotenv": "16.4.7",
    "drizzle-orm": "^0.38.3",
    "helmet": "^8.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "swisseph-v2": "^1.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20"
  }
}
