# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
*.tsbuildinfo

# turbo
.turbo/

# vercel
.vercel/

# env — never commit secrets
.env
.env.*
!.env.example

# testing
coverage/

# react native / metro
.metro-health-check*
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/*.keystore
!apps/mobile/android/app/debug.keystore
apps/mobile/ios/Pods/
apps/mobile/ios/build/
*.hprof

# android signing — must never be committed
*.jks
keystore.properties

# os / editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# logs
npm-debug.log*
yarn-error.log*
*.log
# Written by `vercel link`; holds the project and org ids.
.vercel

# Real environment files never get committed. The pattern is deliberately not
# `.env*`, which would also swallow `.env.example` — that file is how anyone
# setting the project up learns which variables it needs.
.env
.env.local
.env.*.local
.env.production
